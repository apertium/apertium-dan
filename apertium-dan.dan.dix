<dictionary>
<alphabet>ÀÁÂÄÅÆÇÈÉÊËÌÍÎÏÑÒÓÔÖØÙÚÛÜàáâäåæçèéêëìíîïñòóôöøùúûüABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-</alphabet>
<sdefs>
  <sdef n="n"   c="Noun"/>
  <sdef n="np"  c="Proper noun"/>
  <sdef n="ut"  c="Common gender (utrum)"/>
  <sdef n="nt"  c="Neuter"/>
  <sdef n="un"  c="Common and neuter"/>
  <sdef n="m"   c="Masculine"/>
  <sdef n="f"   c="Feminine"/>
  <sdef n="mf"  c="Masculine / feminine"/>
  <sdef n="clb"   c="Possible clause boundary"/>
  <sdef n="pstv"  c="-s verbs"/> <!-- TODO: should go on verbs like findes etc. -->

  <sdef n="top"   c="Toponym"/>
  <sdef n="ant"   c="Anthroponym"/>
  <sdef n="cog"   c="Cognomen"/>
  <sdef n="org"  c="Organisation"/>
  <sdef n="al"  c="Altres / misc proper nouns"/>
  <sdef n="attr"  c="Attributive (certain proper nouns)"/>
  <sdef n="init"  c="Initials"/>

  <sdef n="apos"   c="apostrophe"/>
  <sdef n="emph"   c="emphatic"/>
  <sdef n="sp"  c="Singular and plural"/>
  <sdef n="du"  c="dual"/>
  <sdef n="sg"  c="Singular"/>
  <sdef n="pl"  c="Plural"/>
  <sdef n="neg"  c="negation"/>
  <sdef n="unc"   c="Uncountable"/>
  <sdef n="def"   c="Definite"/>
  <sdef n="ind"   c="Indefinite"/>
  <sdef n="qnt"   c="Quantifier"/>
  <sdef n="itg"   c="Interrogative"/>
  <sdef n="dem"   c="Demonstrative"/>
  <sdef n="ord"   c="Ordinal"/>
  <sdef n="acr"   c="Acronym"/>
  <sdef n="expl"  c="Syntactic expletive"/>
  <sdef n="nom"   c="Nominative"/>
  <sdef n="gen"   c="Genitive"/>
  <sdef n="vblex"   c="Lexical (normal) verb"/>
  <sdef n="vbmod"   c="Modal verb"/>
  <sdef n="vaux"  c="Auxiliary verb"/>
  <sdef n="vbser"   c="'To be' verb"/>
  <sdef n="vbhaver"   c="'To have' verb"/>
  <sdef n="actv"  c="Active voice"/>
  <sdef n="pasv"  c="Passive voice"/>
  <sdef n="pres"  c="Present"/>
  <sdef n="past"  c="Past"/>
  <sdef n="imp"   c="Imperfect"/>
  <sdef n="inf"   c="Infinitive"/>
  <sdef n="pp"  c="Past participle"/>
  <sdef n="pprs"  c="Present participle"/>
  <sdef n="part"  c="infinitive participle"/>
  <sdef n="prn"   c="Pronoun"/>
  <sdef n="rel"   c="Relative pronoun"/>
  <sdef n="res"   c="Reciprocal pronoun"/>
  <sdef n="ref"   c="Reflexive pronoun"/>
  <sdef n="acc"   c="Object"/>
  <sdef n="det" />
  <sdef n="p1"  c="First person"/>
  <sdef n="p2"  c="Second person"/>
  <sdef n="p3"  c="Third person"/>
  <sdef n="pos"   c="Possesive"/>
  <sdef n="pst"   c="Positive"/>
  <sdef n="comp"  c="Comparative"/>
  <sdef n="sup"   c="Superlative"/>
  <sdef n="xpst"    c="Positive derivative"/>
  <sdef n="xpsts"   c="Positive derivative of synthetics"/>
  <sdef n="xpsto"   c="Positive derivative of ordinals"/>
  <sdef n="xcomp"   c="Comparative derivative"/>
  <sdef n="xsup"    c="Superlative derivative"/>
  <sdef n="cnjcoo"  c="Co-ordinating conjunction"/>
  <sdef n="cnjsub"  c="Sub-ordinating conjunction"/>
  <sdef n="cnjadv" />
  <sdef n="pr"  c="Preposition"/>
  <sdef n="ij"  c="Interjection"/>
  <sdef n="num"   c="Numbers"/>
  <sdef n="adv"   c="Adverb"/>
  <sdef n="preadv"  c="Preadverbial"/>
  <sdef n="adj"   c="Adjective"/>
  <sdef n="sint"   c="Synthetic (adjectives that have comp/sup forms, instead of taking mer/mest)"/>
  <sdef n="sent"  c="End of sentence"/>
  <sdef n="cm"  c="Comma"/>
  <sdef n="lpar"  c="Left parenthesis ("/>
  <sdef n="rpar"  c="Right parenthesis )"/>
  <sdef n="lquot" 	c="Left quote"/>
  <sdef n="rquot" 	c="Right quote"/>

  <sdef n="date"      c="Dates, years"/>
  <sdef n="url" 	c="URL/E-mail"/>

  <sdef n="pers"  c="Personal Pronoun"/>
  <sdef n="guess"   c="Guesser"/>
  <sdef n="cgguess"   c="CG Guesser"/>
  <sdef n="compound-only-L"   c="May only be the left-side of a compound"/>
  <sdef n="compound-R"  c="May be the right-side of a compound, or a full word"/>
  <sdef n="cmp"   c="Generation only: added by transfer to say we have a compound"/>
  <sdef n="cmp-split"   c="Left part of a split compound"/>
  <sdef n="guio"  c="Dash, also: Generation only-mark added by transfer to say we should add a dash (e.g. for split compounds)"/>

  <sdef n="remspc" c="Tell transfer to remove preceding space"/>
</sdefs>

<pardefs>





<!-- Genitive case endings -->
<!-- Pronouns always have a case tag (except where we use det+prn_pos system): -->
<pardef n="s_acc_case">
  <e>       <p><l></l>          <r><s n="acc"/></r></p></e>
  <e>       <p><l>s</l>         <r><s n="gen"/></r></p></e>
</pardef>
<pardef n="s_nom_case">
  <e>       <p><l></l>          <r><s n="nom"/></r></p></e>
  <e>       <p><l>s</l>         <r><s n="gen"/></r></p></e>
</pardef>
<pardef n="s_all_case">
  <e>       <p><l></l>          <r><s n="nom"/></r></p></e>
  <e>       <p><l></l>          <r><s n="acc"/></r></p></e>
  <e>       <p><l>s</l>         <r><s n="gen"/></r></p></e>
</pardef>
<!-- Nouns, determiners, adj's only have genitive case tag, otherwise unmarked: -->
<pardef n="s_case" c="Case endings for nouns not ending on s (mand / mands)">
  <e>       <p><l></l>          <r></r></p></e>
  <e>       <p><l>s</l>         <r><s n="gen"/></r></p></e>
</pardef>
<pardef n="'s_case">
  <e>       <p><l></l>          <r></r></p></e>
  <e>       <p><l>'s</l>        <r><s n="gen"/></r></p></e>
</pardef>
<pardef n="'_case" c="Case endings for nouns ending on s (hus / hus')">
  <e>       <p><l></l>          <r></r></p></e>
  <e>       <p><l>'</l>         <r><s n="gen"/></r></p></e>
</pardef>


    <!-- Compounding pardefs. -->
<!-- The cmp tag may be added by transfer to sg.ind forms. Even nouns
 that can't be analysed in compounds, can be generated in
 compounds, and need to be able to make the sg.ind.cmp form.
 Ø-ep... outputs no epenthetic if used as compound-L -->
<pardef n="s_case\-_no-cp" c="Used by proper nouns">
  <e>       <p><l></l>          <r></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp"/></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
  <e r="RL"><p><l>s-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e>       <p><l>s</l>         <r><s n="gen"/></r></p></e>
</pardef>
<pardef n="s_case\Ø_no-cp">
  <e>       <p><l></l>          <r></r></p></e>
  <e r="RL"><p><l></l>          <r><s n="cmp"/></r></p></e>
  <e>       <p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e>       <p><l>s</l>         <r><s n="gen"/></r></p></e>
  <e>       <p><l>s-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
</pardef>
<pardef n="'s_case\Ø_no-cp">
  <e>       <p><l></l>          <r></r></p></e>
  <e r="RL"><p><l></l>          <r><s n="cmp"/></r></p></e>
  <e>       <p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e>       <p><l>'s</l>        <r><s n="gen"/></r></p></e>
  <e>       <p><l>'-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
</pardef>
<pardef n="'_case\Ø_no-cp">
  <e>       <p><l></l>          <r></r></p></e>
  <e r="RL"><p><l></l>          <r><s n="cmp"/></r></p></e>
  <e>       <p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e>       <p><l>'</l>         <r><s n="gen"/></r></p></e>
  <e>       <p><l>'-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
</pardef>
<pardef n="s_case\s_no-cp">
  <e>       <p><l></l>          <r></r></p></e>
  <e r="RL"><p><l>s</l>         <r><s n="cmp"/></r></p></e>
  <e>       <p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e>       <p><l>s</l>         <r><s n="gen"/></r></p></e>
  <e>       <p><l>s-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
</pardef>

<!-- These compound pardefs are for nouns that can also be analysed as
 parts of compounds (if using lt-proc -e option). The
 cp-both... ones are used for sg.ind forms, and thus need to be
 able to generate the sg.ind.cmp form too -->
<pardef n="cp-L" c="use this anywhere we want compound-only-L; does *not* have a fallthrough">
  <e r="RL"><p><l></l>          <r><s n="cmp"/></r></p></e>
  <e r="LR"><p><l></l>          <r><s n="cmp"/><s n="compound-only-L"/></r></p></e>
  <e r="RL"><p><l>-</l>         <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="LR"><p><l>-</l>         <r><s n="cmp"/><s n="guio"/><s n="compound-only-L"/></r></p></e>
  <e>       <p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
</pardef>
<pardef n="cp-R" c="cp-R, for forms that can only end compounds, with untagged fallthrough">
  <e>       <p><l></l>          <r></r></p></e>
  <e>       <p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
  <e r="LR"><p><l></l>          <r><s n="compound-R"/></r></p></e>
</pardef>

<pardef n="cp-L-nodash" c="like cp-L, but assume left side already ends in dash">
  <e r="RL"><p><l></l>          <r><s n="cmp"/></r></p></e>
  <e r="LR"><p><l></l>          <r><s n="cmp"/><s n="compound-only-L"/></r></p></e>
  <e r="RL"><p><l></l>          <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e>       <p><l></l>          <r><s n="cmp-split"/></r></p></e>
</pardef>
<pardef n="cp-R-nosplit" c="like cp-R, but don't generate cmp/cmp-split                             (assuming calling pardef takes care of RL cmp/cmp-split, e.g. if using cp-L)">
  <e>       <p><l></l>          <r></r></p></e>
  <e r="LR"><p><l></l>          <r><s n="compound-R"/></r></p></e>
  <e>       <p><l>NON_ANALYSIS</l><r>DUE_TO_LT_PROC_HANG</r></p></e>
</pardef>

<pardef n="cp-guio" c="used for guesser">
  <e r="RL"><p><l></l>            <r><s n="cmp"/><s n="guio"/></r></p></e>
  <e r="LR"><p><l></l>            <r><s n="cmp"/><s n="guio"/><s n="compound-only-L"/></r></p></e>
</pardef>

<pardef n="\Ø_cp-only-L" c="cp-only-L, for forms that can only start compounds">
  <e>       <p><l></l>          <r></r></p><par n="cp-L"/></e>
  <e>       <p><l>s-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
</pardef>
<pardef n="\s_cp-only-L" c="cp-only-L, for forms that can only start compounds; with s-epenthetic">
   <e>       <p><l>s</l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l>s-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
</pardef>
<pardef n="\e_cp-only-L" c="cp-only-L, for forms that can only start compounds">
  <e>       <p><l>e</l>          <r></r></p><par n="cp-L"/></e>
  <e>       <p><l>s-</l>        <r><s n="gen"/><s n="cmp-split"/></r></p></e>
</pardef>

<pardef n="s_case\Ø\s_cp-both" c="cp-L and cp-R. Analyse both -Ø- and -s- in compounds, generate -Ø- if cp-L">
   <e>       <p><l></l>          <r></r></p><par n="cp-L"/></e>
   <e r="LR"><p><l>s</l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="'_case\Ø\s_cp-both" c="As above, but with ' in the genitive case.">
   <e>       <p><l></l>          <r></r></p><par n="cp-L"/></e>
   <e r="LR"><p><l>s</l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>'</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="'_case\e\Ø_cp-both" c="As above, but with ' in the genitive case.">
   <e>       <p><l>e</l>          <r></r></p><par n="cp-L"/></e>
   <e r="LR"><p><l></l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>'</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="s_case\s\Ø_cp-both" c="cp-L and cp-R. Analyse both -Ø- and -s- in compounds, generate -s- if cp-L">
   <e r="LR"><p><l></l>          <r></r></p><par n="cp-L"/></e>
   <e>       <p><l>s</l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="s_case\e_cp-both" c="cp-L and cp-R. Analyse only -e- in compounds, generate -e- if cp-L">
   <e>       <p><l>e</l>         <r></r></p><par n="cp-L"/></e>
   <e r="LR"><p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="s_case\s_cp-both" c="cp-L and cp-R. Analyse only -s- in compounds, generate -s- if cp-L">
   <e>       <p><l>s</l>         <r></r></p><par n="cp-L"/></e>
   <e r="LR"><p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="s_case\me_cp-both" c="cp-L and cp-R. Analyse only -s- in compounds, generate -s- if cp-L">
   <e>       <p><l>me</l>         <r></r></p><par n="cp-L"/></e>
   <e r="LR"><p><l>-</l>         <r><s n="cmp-split"/></r></p></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="'_case\s\Ø_cp-both" c="As above, but with ' in the genitive case">
   <e>       <p><l>s</l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>'</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>

<pardef n="s_case\e\Ø_cp-both" c="cp-L and cp-R. Analyse -Ø- and -e- in compounds, generate -e- if cp-L">
   <e>       <p><l>e</l>         <r></r></p><par n="cp-L"/></e>
   <e r="LR"><p><l></l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="s_case\Ø\e_cp-both" c="cp-L and cp-R. Analyse -e- and -Ø- in compounds, generate -Ø- if cp-L">
   <e r="LR"><p><l>e</l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>         <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="s_case\Ø_cp-both" c="cp-L and cp-R. Analyse only -Ø- in compounds, generate -Ø- if cp-L">
   <e>       <p><l></l>          <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="s_case\-_cp-both" c="cp-L and cp-R. Analyse only dash in compounds, generate dash if cp-L">
   <e>       <p><l>-</l>         <r></r></p><par n="cp-L-nodash"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="'s_case\-_cp-both" c="cp-L and cp-R. Analyse only dash in compounds, generate dash if cp-L">
   <e>       <p><l>-</l>         <r></r></p><par n="cp-L-nodash"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>'s</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="ens_case\Ø_cp-both" c="cp-L and cp-R. Analyse only -Ø- in compounds, generate -Ø- if cp-L">
   <e>       <p><l></l>          <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>ens</l>       <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="'_case\Ø_cp-both" c="As above, but with ' in the genitive case">
   <e>       <p><l></l>          <r></r></p><par n="cp-L"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>'</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>
<pardef n="'_case\-_cp-both" c="As above, but with dash in compounds">
   <e>       <p><l>-</l>         <r></r></p><par n="cp-L-nodash"/></e>
   <e>       <p><l></l>          <r></r></p><par n="cp-R-nosplit"/></e>
   <e>       <p><l>'</l>         <r><s n="gen"/></r></p><par n="cp-R"/></e>
</pardef>

<!-- Punctuation  -->

<pardef n="numeros">
  <!-- separate out the number 1 as singular (fortunately "1.00" is usually plural!) -->
  <e>       <re>1( ?%)?</re><p><l></l>                   <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p></e>
  <e>       <re>[02-9]+( ?%)?</re><p><l></l>             <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e>       <re>[0-9][0-9]+( ?%)?</re><p><l></l>         <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>
  <e>       <re>[0-9]+([., ][0-9]+)+( ?%)?</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <e>       <re>[0-9]+([., ][0-9]+)* (tusen|[mb]illi(on|ard)er)</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <e>       <re>[½¹²³¼¾]</re><p><l></l>                  <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/></r></p></e>

  <!-- Numbers from 1000 to 2200 (or 20-99) might be years. Other numbers don't get to be years.
       Noun tagging would be better, but that doesn't work with compounding
       since inconditional numerals override the unknown-analysis. -->
  <e c="date"><re>1[0-9][0-9][0-9]|2[0-2][0-9][0-9]|[2-9][0-9]</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><s n="date"/></r></p></e>
  <e c="section"> <re>[0-9]+[\-][0-9]+</re><p><l></l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/></r></p></e>

  <e>       <re>1</re><p><l>.</l>                        <r><s n="det"/><s n="qnt"/><s n="un"/><s n="sg"/><j/>.<s n="sent"/><s n="clb"/><s n="remspc"/></r></p></e>
  <e>       <re>[02-9]</re><p><l>.</l>                   <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><j/>.<s n="sent"/><s n="clb"/><s n="remspc"/></r></p></e>
  <e>       <re>[0-9][0-9]+([., ][0-9]+)?</re><p><l>.</l><r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><j/>.<s n="sent"/><s n="clb"/><s n="remspc"/></r></p></e>
  <e>       <re>[0-9][., ][0-9]+</re><p><l>.</l>         <r><s n="det"/><s n="qnt"/><s n="un"/><s n="pl"/><j/>.<s n="sent"/><s n="clb"/><s n="remspc"/></r></p></e>
</pardef>

<pardef n="separa">
  <e>       <p><l>..</l><r>..<s n="sent"/><s n="clb"/></r></p></e>
  <e>       <p><l>...</l><r>...<s n="sent"/><s n="clb"/></r></p></e>
  <e>       <re>[.\?;:!…¿¶\|]</re><p><l></l><r><s n="sent"/><s n="clb"/></r></p></e>
</pardef>

<pardef n="coma">
  <e>       <re>,</re><p><l></l><r><s n="cm"/><s n="clb"/></r></p></e>
  <e>       <re>,</re><p><l></l><r><s n="cm"/></r></p></e>
  <e>       <p><l>/</l><r>/<s n="cm"/></r></p></e>
</pardef>

<pardef n="aposchar">
  <e>       <i>'</i></e>
</pardef>

<pardef n="cometa">
  <e>       <par n="aposchar"/><p><l></l><r><s n="apos"/></r></p></e>
  <e>       <p><l>«</l><r>«<s n="lquot"/></r></p></e>
  <e>       <p><l>»</l><r>»<s n="rquot"/></r></p></e>
</pardef>

<pardef n="paresq">
  <e>       <re>[\(\[{]</re><p><l></l><r><s n="lpar"/></r></p></e>
</pardef>

<pardef n="pardret">
  <e>       <re>[\)\]}]</re><p><l></l><r><s n="rpar"/></r></p></e>
</pardef>


<pardef n="sgpl_def_gen" c="used by nominalisations of adj's">
  <e><p><l></l> <r><s n="sg"/><s n="def"/><s n="gen"/></r></p></e>
  <e><p><l></l> <r><s n="pl"/><s n="def"/><s n="gen"/></r></p></e>
  <e r="RL"><p><l></l> <r><s n="sg"/><s n="ind"/><s n="gen"/></r></p></e>
  <e r="RL"><p><l></l> <r><s n="pl"/><s n="ind"/><s n="gen"/></r></p></e>
</pardef>

