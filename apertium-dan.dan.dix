<e lm="meningo">              <i>meningo</i><par n="kommunal__n_cmp"/></e>
<e lm="sub">              <i>sub</i><par n="kommunal__n_cmp"/></e>

  </section>

  <section id="regex" type="standard">
  <!-- a-z* regexes lead to blow-up (2M → 15M) when in main section, keep them here: -->

  <!-- G20, F-35, RAV4 etc. -->
  <e lm="G20">    <re>[A-ZÆØÅ]+\-?[0-9][0-9A-ZÆØÅ]*</re><par n="EP_\-__n"/></e>
  <e r="RL" lm="G20"><re>[a-zæøå]+\-?[0-9][0-9a-zæøå]*</re><par n="EP_\-__n"/></e> <!-- TODO: transfer bug, shouldn't lowercase these, but don't fail if we do -->
  <e lm="A-Z"> <re>[A-Z]</re><par n="d'or__np"/></e>
  <e lm="A-ZS"> <re>[A-Z]S</re><par n="d'or__np"/></e> <!-- since A-Z<gen> matches "AS" and generates "As" -->

  <!-- initials: H.C. Andersen -->
  <e lm="A-Å."> <par n="A-Å."/><par n="initial__np"/></e>
  <e lm="A-Å.A-Å."> <par n="A-Å."/><par n="A-Å."/><par n="initial__np"/></e>
  <e lm="A-Å.A-Å.A-Å."> <par n="A-Å."/><par n="A-Å."/><par n="A-Å."/><par n="initial__np"/></e>

  <e lm="alphabet">        <par n="letter"/><par n="/alphabet__n"/></e>

  <e lm="AZ-basert"> <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><i>basere</i><par n="øve/t__adj"/></e>
  <e lm="AZ-ulykka"> <re>[A-ZÆØÅ]+[a-zæøå]*\-</re><i>ulykke</i><par n="hygiejne__n"/></e>
  <e lm="0-9-årig"> <re>[0-9]+</re><i>-årig</i><par n="lykkelig__adj"/></e>

  <!-- For generating forms that were "analysed" by CG -->
  <e r="RL" lm="np cgguess regex"><par n="lowerdash+"/><par n="cgguess__np"/></e>

  <!-- For analysing name-compound-parts ending in dash (letting the second part be looked up in .dix, something CG can't do): -->
  <!-- not using letter pardefs since that makes the final transducer huge -->
  <e lm="np-guio regex"><re>[A-ZÆØÅ][a-zæøå]+\-</re><p><l/><r><s n="np"/><s n="guess"/></r></p><par n="cp-guio"/></e>
  <!-- avoid lttoolbox#167: -->
  <!-- <e lm="np-guio regex"><re>[A-ZÆØÅ][A-ZÆØÅ]+\-</re><p><l/><r><s n="np"/><s n="guess"/></r></p><par n="cp-guio"/></e> -->
  <!-- <e lm="np-apos regex"><re>[A-ZÆØÅ][A-ZÆØÅa-zæøå\-]+[SZXszx]'</re><p><l/><r><s n="np"/><s n="guess"/><s n="gen"/></r></p></e> -->
  <e lm="np-apos regex"><re>[A-ZÆØÅ][a-zæøå\-]+[szx]'</re><p><l/><r><s n="np"/><s n="guess"/><s n="gen"/></r></p></e>

  <!-- <e lm="eitt–millionar år lang"> <par n="cardinals"/> <i><b/>år<b/>l</i> <par n="l/ang__adj"/></e> -->
  <!-- <e lm="eitt–millionar år gammal"> <par n="cardinals"/> <i><b/>år<b/></i> <par n="/gammel__adj"/></e> -->

  <!-- Numbers are *not* in inconditional, since that would block compounding with them: -->
  <e>                      <par n="numeros"/></e>


  <!-- to get things like «MAX 8-fly» as two tokens instead of four (though one would be even better): -->
  <e lm="0-9+">        <re>[0-9]([0-9–\-]*[0-9])?</re><par n="8__n_cmp"/></e>


  <!-- 22.30-tiden needs a non-compund entry, otherwise it gets tokenised
       as 22.<adj><ord>-<guio>tid<n> since the adj.ord are inconditional:-->
  <e lm="22.30-tiden">         <re>[0-9]+[.][0-9]+</re><i>-tid</i><par n="aften__n"/></e>
  <e lm="13.-plads">           <re>[0-9]+[.]</re><i>-plads</i><par n="residens__n"/></e>
  <e lm="13.-klasseelev">      <re>[0-9]+[.]</re><i>-klasseelev</i><par n="aften__n"/></e>
  <e lm="13.-omgang">          <re>[0-9]+[.]</re><i>-omgang</i><par n="bold__n"/></e>
  <e lm="13.-division">        <re>[0-9]+[.]</re><i>-divisjon</i><par n="ising__n"/></e>
  <e lm="13.-divisionafdeling"><re>[0-9]+[.]</re><i>-divisionsafdeling</i><par n="ising_\s__n"/></e>
  <e lm="13.-hold">            <re>[0-9]+[.]</re><i>-hold</i><par n="slag__n"/></e>
  <e lm="13.-månedersalder">   <re>[0-9]+</re><i><b/>måneders<b/>alder</i><par n="a-kraft__n"/></e>
  <e r="LR" lm="13.-månedersalder"><re>[0-9–—\-]+</re><p><l>-månedersalder</l><r><b/>måneders<b/>alder</r></p><par n="a-kraft__n"/></e>
  <!-- And a non-compound (but cmp-tagged) entry for the general case to analyse
       things like «1.000-kroneseddel» as ^1.<n><cmp>$^000<n><cmp>$^seddel<n>$,
       but without using the compound machinery (which would be overridden by inconditionals): -->
  <e lm="0-9+.">        <re>[0-9]+[.]</re><p><l></l><r><s n="n"/><s n="m"/><s n="sg"/><s n="ind"/><s n="cmp"/></r></p></e>

  <e lm="foo.com"> <re>(https?://)?(www.)?([a-zæøå0-9\-_]+[.])+(com|no|net|co[.]uk|fr|se|biz|dk|gov|org|nz|uk|eu)+(/[a-zæøå0-9\-_/]*)?</re><p><l></l><r><s n="url"/></r></p></e>

  <!-- used in fao-nob: -->
  <e r="RL" lm="regex"><re>[A-Z][a-z]+</re><p><l></l><r><s n="np"/><s n="guess"/></r></p></e>
</section>

<section id="final" type="inconditional">
  <e>                      <par n="separa"/></e>
  <e>                      <par n="coma"/></e>
  <e>                      <par n="cometa"/></e>
  <e>                      <par n="paresq"/></e>
  <e>                      <par n="pardret"/></e>
  <e><p><l>-</l><r>-<s n="guio"/></r></p></e>
  <e><p><l>–</l><r>–<s n="guio"/><s n="clb"/></r></p></e> <!-- en dash -->
  <e><p><l>—</l><r>—<s n="guio"/><s n="clb"/></r></p></e> <!-- em dash -->


  <e lm="[0-9]+.">         <re>[0-9]+</re><i>.</i><par n="1.__adj"/></e>

  <e>     <p><l>❡</l><r>❡<s n="sent"/><s n="clb"/></r></p></e>
  <e>     <p><l>@</l><r>@<s n="guio"/></r></p></e>

</section>

</dictionary>
